{#
    One project on the homepage. Expects `project` (a collection item) and
    `loop` from the surrounding for-loop. Every second row is mirrored.
#}
{%- set data = project.data %}

<article class="project-row{{ ' reverse' if loop.index is even }} reveal">

    <div class="project-visual {{ data.visual.id }}-visual">

        {# Optional per-project animation: partials/visuals/<id>.njk #}
        {% include "partials/visuals/" + data.visual.id + ".njk" ignore missing %}

        <div class="visual-label">
            {{ data.visual.label }}
        </div>

        <div class="visual-center">
            <span>{{ data.visual.kicker }}</span>
            <strong>{{ data.visual.headline }}</strong>
        </div>

    </div>

    <div class="project-content">

        <p class="project-number">
            PROJECT {{ loop.index | pad }}
        </p>

        <h3>{{ data.title }}</h3>

        <p class="project-description">
            {{ data.summary }}
        </p>

        <div class="project-tech">
            {%- for item in data.tech %}
            <span>{{ item }}</span>
            {%- endfor %}
        </div>

        {%- if data.links.github %}

        <a
            class="project-link"
            href="{{ data.links.github }}"
            target="_blank"
            rel="noopener"
        >
            View Project <span>↗</span>
        </a>
        {%- endif %}

    </div>

</article>
