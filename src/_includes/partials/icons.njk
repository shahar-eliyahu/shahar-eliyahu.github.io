{%- else -%}
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    {%- if name == "arrow-down" -%}<path d="M12 5v14M19 12l-7 7-7-7"/>
    {%- elif name == "arrow-right" -%}<path d="M5 12h14M12 5l7 7-7 7"/>
    {%- elif name == "arrow-up-right" -%}<path d="M7 17 17 7M7 7h10v10"/>
    {%- elif name == "download" -%}<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
    {%- elif name == "play" -%}<circle cx="12" cy="12" r="9"/><path d="m10 8.5 5 3.5-5 3.5Z"/>
    {%- elif name == "image" -%}<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="1.5"/><path d="m21 16-5-5-9 9"/>
    {%- elif name == "mail" -%}<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
    {%- endif -%}
</svg>
{%- endif -%}
{% endmacro %}
