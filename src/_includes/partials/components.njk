{#
    Reusable UI pieces. Import with:
    {% from "partials/components.njk" import sectionTitle, button, profileButtons %}
#}
{% from "partials/icons.njk" import icon as svgIcon %}


{# Section heading: just the title (no number or label above it) #}
{% macro sectionTitle(title) %}
<div class="section-title reveal">
    <h2 class="section-heading">{{ title }}</h2>
</div>
{% endmacro %}


{#
    Button link.
    variant:  hierarchy / style class: "primary", "secondary", "ghost",
              "light", "dark-outline" (or "" for the default outline)
    kind:     "external" opens in a new tab, "download" downloads the file
    icon:     optional icon name from partials/icons.njk, shown before the label
    trailingIcon: optional icon name shown after the label
#}
{% macro button(label, href, variant = "", kind = "", filename = "", icon = "", trailingIcon = "") %}
<a
    class="button{{ ' ' + variant if variant }}"
    href="{{ href }}"
    {%- if kind == "external" %}
    target="_blank"
    rel="noopener"
    {%- elif kind == "download" %}
    download="{{ filename }}"
    {%- endif %}
>
    {%- if icon %}{{ svgIcon(icon) }}{% endif %}
    <span>{{ label | safe }}</span>
    {%- if trailingIcon %}{{ svgIcon(trailingIcon) }}{% endif %}
    {%- if kind == "external" %}<span class="sr-only"> (opens in a new tab)</span>{% endif %}
</a>
{% endmacro %}


{# CV, GitHub and LinkedIn buttons, shared by the hero and contact sections #}
{% macro profileButtons(site, cvVariant = "", linkVariant = "") %}
{{ button("Download CV", site.cv, cvVariant, "download", site.cvFilename, icon = "download") }}
{{ button("GitHub", site.social.github, linkVariant, "external", icon = "github") }}
{{ button("LinkedIn", site.social.linkedin, linkVariant, "external", icon = "linkedin") }}
{% endmacro %}
