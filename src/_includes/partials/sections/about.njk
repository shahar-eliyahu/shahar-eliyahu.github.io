{% from "partials/components.njk" import sectionTitle %}
{% set about = home.about %}

<section id="about" class="section about-section">

    {#- Text only: the heading sits beside the text on desktop, above it below 1024px #}
    <div class="container about-layout">

        {{ sectionTitle(about.title) }}

        <div class="about-text reveal">
            {%- for paragraph in about.paragraphs %}
            <p>{{ paragraph | safe }}</p>
            {%- endfor %}
        </div>

    </div>

</section>
