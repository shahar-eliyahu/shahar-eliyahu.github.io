{% from "partials/components.njk" import sectionTitle %}
{% set section = home.skills %}

<section id="skills" class="section">

    <div class="container">

        {{ sectionTitle(section.number, section.kicker, section.title) }}

        {#- One row per category: name, then its technologies as tags #}
        <div class="skills-list" data-stagger>
            {%- for group in skills %}

            <div class="skill-row reveal">
                <h3 class="skill-name" id="skills-{{ loop.index }}">{{ group.name }}</h3>

                <ul class="tech-list skill-tags" aria-labelledby="skills-{{ loop.index }}">
                    {%- for item in group.items %}
                    <li class="tech-badge">{{ item }}</li>
                    {%- endfor %}
                </ul>
            </div>
            {%- endfor %}

        </div>

    </div>

</section>
