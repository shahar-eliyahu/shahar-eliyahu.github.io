{% from "partials/components.njk" import button, profileButtons %}
{% set hero = home.hero %}

<section id="home" class="hero">

    <div class="hero-grid" aria-hidden="true"></div>
    <div class="hero-spotlight" aria-hidden="true"></div>
    <div class="hero-blob hero-blob-one" aria-hidden="true"></div>
    <div class="hero-blob hero-blob-two" aria-hidden="true"></div>

    <div class="container hero-content" data-stagger>

        <p class="hero-label reveal">
            <span class="status-dot"></span>
            {{ hero.label }}
        </p>

        <div class="hero-name reveal">

            <h1>
                {{ hero.nameLines | join("<br>") | safe }}
            </h1>

            <div class="name-box" aria-hidden="true">
                <div class="box-frame">
                    <i class="corner tl"></i>
                    <i class="corner tr"></i>
                    <i class="corner bl"></i>
                    <i class="corner br"></i>
                </div>

                <span class="name-box-label">
                    {{ hero.detectionLabel }}
                    <b class="confidence">{{ hero.detectionConfidence }}</b>
                </span>
            </div>

        </div>

        <p class="hero-subtitle reveal">
            {{ hero.subtitle }}
        </p>

        <div class="hero-buttons reveal">
            {{ button("View Projects", "#projects", "primary") }}
            {{ profileButtons(site) }}
        </div>

    </div>

</section>
