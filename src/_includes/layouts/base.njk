<!DOCTYPE html>
<html lang="{{ site.language }}">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#172238">

    <meta name="description" content="{{ description or site.description }}">

    {%- set pageTitle = (title + " | " + site.name) if title else site.title %}
    {%- set pageDescription = description or site.description %}

    <title>{{ pageTitle }}</title>

    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    {%- if noindex %}
    <meta name="robots" content="noindex">
    {%- else %}
    {%- set pageUrl = site.url + page.url %}
    {#- Preview image: the project's cover when it suits a wide card, otherwise
        site.socialImage if one is set ({ url, width, height, alt }) #}
    {%- set socialImg = (cover | socialImage(slug)) or site.socialImage %}

    <link rel="canonical" href="{{ pageUrl }}">

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="{{ site.name }}">
    <meta property="og:title" content="{{ pageTitle }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ pageUrl }}">
    {%- if socialImg %}
    <meta property="og:image" content="{{ site.url }}{{ socialImg.url }}">
    <meta property="og:image:width" content="{{ socialImg.width }}">
    <meta property="og:image:height" content="{{ socialImg.height }}">
    <meta property="og:image:alt" content="{{ socialImg.alt }}">
    {%- endif %}

    <meta name="twitter:card" content="{{ 'summary_large_image' if socialImg else 'summary' }}">
    <meta name="twitter:title" content="{{ pageTitle }}">
    <meta name="twitter:description" content="{{ pageDescription }}">
    {%- if socialImg %}
    <meta name="twitter:image" content="{{ site.url }}{{ socialImg.url }}">
    <meta name="twitter:image:alt" content="{{ socialImg.alt }}">
    {%- endif %}
    {%- endif %}

    {#- Fonts are self-hosted (assets/fonts, @font-face in base.css). The hero
        shows Plex Mono above the fold, so the homepage preloads that weight. #}
    <link rel="preload" href="/assets/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
    {%- if page.url == "/" %}
    <link rel="preload" href="/assets/fonts/ibm-plex-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
    {%- endif %}

    <script>document.documentElement.classList.add("js");</script>

    <link rel="stylesheet" href="/assets/css/tokens.css">
    <link rel="stylesheet" href="/assets/css/base.css">
    <link rel="stylesheet" href="/assets/css/sections.css">
    <link rel="stylesheet" href="/assets/css/visuals.css">

    <script src="/assets/js/main.js" defer></script>
    <script src="/assets/js/editor.js" defer></script>
    <script src="/assets/js/gallery.js" defer></script>
    <script src="/assets/js/projects.js" defer></script>
</head>

<body>

{% include "partials/nav.njk" %}

<main>
{{ content | safe }}
</main>

{% include "partials/footer.njk" %}

</body>
</html>
